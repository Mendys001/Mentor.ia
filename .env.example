# ==============================================================================
# CONFIGURACIÓN DE MENTOR.IA
# ==============================================================================

# Clave de API de Google Gemini (Google AI Studio)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY="tu_api_key_aqui"

# Modelo de lenguaje para generación de respuestas
# Modelos disponibles: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL="gemini-3.8-flash"

# Modelos de respaldo, en orden y separados por comas, si el principal falla (503, 429, tiempo agotado).
# Usa modelos DISTINTOS al principal ("gemini-flash-latest" puede apuntar al mismo modelo saturado).
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite,gemini-3.6-flash"

# Nivel de "pensamiento": minimal, low, medium, high ("low" = respuestas más rápidas)
GEMINI_THINKING_LEVEL="low"

# Modelo para generación de embeddings semánticos
EMBEDDINGS_MODEL="models/gemini-embedding-001"

# URL pública de la app (para los enlaces de "compartir")
APP_BASE_URL="http://localhost:8501"

# Panel técnico (solo desarrollo)
ADMIN_MODE="false"
